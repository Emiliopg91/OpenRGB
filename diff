+-{
+-    const std::string zone_names[2] =
+-    {
+-        "Left" , "Right"
+-    };
+-
+-    for(const std::string& zone_name : zone_names)
+-    {
+-        zone zone;
+-        zone.name           = zone_name;
+-        zone.type           = ZONE_TYPE_SINGLE;
+-        zone.leds_min       = 1;
+-        zone.leds_max       = 1;
+-        zone.leds_count     = 1;
+-        zone.matrix_map     = NULL;
+-        zones.push_back(zone);
+-
+-        led mouse_led;
+-        mouse_led.name      = zone_name;
+-        leds.push_back(mouse_led);
+-    }
+-
+-    SetupColors();
