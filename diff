-            }
-
-        default:
-            controller->SetRegister(FURY_REG_SPEED, modes[active_mode].speed);
-            break;
-        }
-    }
-
-    controller->SetRegister(FURY_REG_BRIGHTNESS,
-                            modes[active_mode].brightness);
-    controller->SetNumSlots();
-    controller->SendApply();
-}
