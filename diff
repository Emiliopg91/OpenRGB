-    /* Make sure the SMBus host is ready to start transmitting */
-    temp = ReadIoPortByte(SMBHSTSTS);
-    if (temp != 0x00)
-    {
-        WriteIoPortByte(SMBHSTSTS, temp);
-        temp = ReadIoPortByte(SMBHSTSTS);
-        if (temp != 0x00)
-        {
-            return -EBUSY;
-        }
-    }
-
-	switch (size)
-	{
-	case I2C_SMBUS_QUICK:
-        WriteIoPortByte(SMBHSTADD, (addr << 1) | read_write);
-		size = PIIX4_QUICK;
-		break;
-    case I2C_SMBUS_BYTE:
-        WriteIoPortByte(SMBHSTADD, (addr << 1) | read_write);
