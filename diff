+-        return;
+-    }
+-
+-    if(modes[active_mode].color_mode == MODE_COLORS_PER_LED)
+-    {
+-        controller->SetAllColorsEffect(&colors[0]);
+-    }
+-
+-    controller->SetMode(modes[active_mode].value);
+-}
