+-                        modes[active_mode].colors.push_back(hw_config.colors[j]);
+-                    }
+-                }
+-            }
+-
+-            modes[active_mode].speed        = hw_config.speed;
+-            modes[active_mode].brightness   = hw_config.brightness;
+-            modes[active_mode].direction    = hw_config.direction;
