+-        unsigned int start_led = 0;
+-
+-        for(int i = 0; i < zone; i++)
+-        {
+-            start_led += zones[i].leds_count;
+-        }
+-
+-        UpdateLEDRange(start_led, zones[zone].leds_count);
+-    }
