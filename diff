-        /*-----------------------------------------------------*\
-        | These modes take no bytes                             |
-        \*-----------------------------------------------------*/
-        case POLYCHROME_V1_MODE_OFF:
-            break;
-    }
-    std::this_thread::sleep_for(1ms);
-
-}
