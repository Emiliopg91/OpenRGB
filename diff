-{
-    std::vector<unsigned int> flat_map;
-
-    for(const std::vector<unsigned int> &row : matrix_map)
-    {
-        for(const unsigned int &item : row)
-        {
-            flat_map.push_back(item);
-        }
-    }
-    return flat_map;
-}
