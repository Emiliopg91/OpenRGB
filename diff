-    /*-----------------------------------------------------*\
-    | Update Hex edit box                                   |
-    \*-----------------------------------------------------*/
-    if(UpdateHex)
-    {
-        RGBColor color = (0x00FFFFFF & current_color.rgb());
-
-        /*-------------------------------------------------*\
-        | If the hex format is BGR, swap R and B before     |
