+-			}
+-
+-			decoded.push_back((temp >> 16) & 0x000000FF);
+-			decoded.push_back((temp >> 8 ) & 0x000000FF);
+-			decoded.push_back((temp      ) & 0x000000FF);
+-		}
+-
+-		return decoded;
+-	}
+-}
