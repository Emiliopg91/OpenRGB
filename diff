-		}
-		size = PIIX4_WORD_DATA;
-		break;
-	case I2C_SMBUS_BLOCK_DATA:
-        WriteIoPortByte(SMBHSTADD, (addr << 1) | read_write);
-        WriteIoPortByte(SMBHSTCMD, command);
-		if (read_write == I2C_SMBUS_WRITE)
-		{
-            len = data->block[0];
