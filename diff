-    unsigned char usb_buf[ROCCAT_KONE_PRO_CONTROL_MODE_PACKET_LENGTH];
-
-    usb_buf[0x00] = 0x0E;
-    usb_buf[0x01] = 0x06;
-    usb_buf[0x02] = 0x01;
-    usb_buf[0x03] = direct ? 0x01 : 0x00;
-    usb_buf[0x04] = 0x00;
