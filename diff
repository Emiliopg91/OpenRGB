-                    std::string major = fwver.substr(0, majorp);
-                    std::string minor = fwver.substr(majorp+1, (minorp-majorp-1));
-                    std::string build = fwver.substr(minorp+1);
-                    return_string = return_string + " / LED: " + major + "." + minor + "." + build;
-                }
-            }
-        }
-    }
-
-    return(return_string);
-}
