+-    for(uint8_t zone_idx = 0; zone_idx < zoneIndexMap.size(); zone_idx++)
+-    {
+-        nv_zone_config.colors[0]  = colors[zone_idx];
+-        nv_zone_config.brightness = modes[active_mode].brightness;
