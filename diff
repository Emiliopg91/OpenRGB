+-    Star.color_mode             = MODE_COLORS_MODE_SPECIFIC;
+-    Star.speed                  = CM_RGBC_SPEED_STAR_SLOWEST;
+-    Star.brightness_min         = 0x00;
+-    Star.brightness_max         = 0xFF;
