-void RGBController_HyperXAlloyFPS::KeepaliveThreadFunction()
-{
-    while(keepalive_thread_run)
-    {
-        if(active_mode == 0)
-        {
-            if((std::chrono::steady_clock::now() - last_update_time) > std::chrono::milliseconds(50))
-            {
-                UpdateLEDs();
-            }
-        }
-        std::this_thread::sleep_for(10ms);;
-    }
-}
