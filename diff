+-
+-    /*-----------------------------------------------------*\
+-    | Zero out buffer, set up packet and send               |
+-    \*-----------------------------------------------------*/
+-    memset(buf, 0x00, sizeof(buf));
+-    buf[0x00]   = 0;
+-    buf[0x01]   = 0x89;
+-    buf[0x02]   = profile;
+-    hid_send_feature_report(dev, buf, 65);
+-}
