+-            active_mode = 0;
+-        }
+-    }
+-
+-    modes[active_mode].speed      = active.speed;
+-    modes[active_mode].brightness = active.brightness;
+-
+-    for(uint8_t i = 0; i < 20; i++)
+-    {
+-        colors[i] = active.colors[i].color;
+-    }
