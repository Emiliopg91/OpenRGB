+-void CorsairLightingNodeController::KeepaliveThread()
+-{
+-    while(keepalive_thread_run.load())
+-    {
+-        if((std::chrono::steady_clock::now() - last_commit_time) > std::chrono::seconds(5))
+-        {
+-            SendCommit();
+-        }
+-        std::this_thread::sleep_for(1s);
+-    }
+-}
