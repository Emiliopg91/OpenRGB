+-#define CORSAIR_ICUE_LINK_MODE_GET_TEMPERATURES      {0x21,}
+-#define CORSAIR_ICUE_LINK_MODE_GET_SPEEDS            {0x17,}
+-#define CORSAIR_ICUE_LINK_MODE_SET_SPEED             {0x18,}
