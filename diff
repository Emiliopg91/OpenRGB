+-        return;
+-    }
+-
+-    unsigned int Area_num = 0;
+-    if(controller->support_Global_zone == true)
+-    {
+-        Area_num = controller->GetZoneCount() - 1;
+-    }
+-    else
+-    {
+-        Area_num = controller->GetZoneCount();
+-    }
+-    for(unsigned int i = 0; i < Area_num; i++)
