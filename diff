+-void SteelSeriesSenseiController::Save()
+-{
+-    /*-----------------------------------------------------*\
+-    | Saves to the internal configuration                   |
+-    \*-----------------------------------------------------*/
+-    unsigned char usb_buf[9];
+-
+-    /*-----------------------------------------------------*\
+-    | Zero out buffer                                       |
+-    \*-----------------------------------------------------*/
+-    memset(usb_buf, 0x00, sizeof(usb_buf));
+-
+-    /*-----------------------------------------------------*\
+-    | Set up Save packet                                    |
+-    \*-----------------------------------------------------*/
+-    usb_buf[0x00]       = 0x59;
+-
+-    /*-----------------------------------------------------*\
