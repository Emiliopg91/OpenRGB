+-
+-    mode current_mode = modes[active_mode];
+-    if(prv_mode != current_mode.value)
+-    {
+-        controller->SelectMode(current_mode.value);
+-        prv_mode = current_mode.value;
+-    }
+-
+-    DeviceUpdate(current_mode);
+-}
