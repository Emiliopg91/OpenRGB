+-    ENERegisterWrite(XTREEM_REG_SPEED,     speed);
+-    ENERegisterWrite(XTREEM_REG_DIRECTION, direction);
+-    ENERegisterWrite(XTREEM_REG_APPLY,     XTREEM_APPLY_VAL);
