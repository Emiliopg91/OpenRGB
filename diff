+-void SteelSeriesRivalController::SetColor
+-    (
+-    unsigned char   zone_id,
+-    unsigned char   red,
+-    unsigned char   green,
+-    unsigned char   blue
+-    )
+-{
+-    unsigned char usb_buf[9];
+-    memset(usb_buf, 0x00, sizeof(usb_buf));
+-
+-    switch(proto)
+-    {
+-        case RIVAL_100:
+-            usb_buf[0x00]       = 0x05;
+-            usb_buf[0x01]       = 0x00;
+-            break;
+-
+-        case RIVAL_300:
+-            usb_buf[0x00]       = 0x08;
+-            usb_buf[0x01]       = zone_id + 1;
+-            break;
+-
+-        case RIVAL_650:
+-            SetRival650Color(zone_id, red, green, blue);
+-            return;
+-
+-        case RIVAL_600:
+-            SetRival600Color(zone_id, red, green, blue);
+-            return;
+-
+-        case RIVAL_700:
+-            SetRival700Color(zone_id, red, green, blue);
+-            return;
+-
+-        default:
+-            break;
+-    }
+-
+-    usb_buf[0x02]       = red;
+-    usb_buf[0x03]       = green;
+-    usb_buf[0x04]       = blue;
+-
+-    send_usb_msg(dev, usb_buf, 9);
+-}
+-
+-void SteelSeriesRivalController::SetColorAll
+-    (
+-        unsigned char   red,
+-        unsigned char   green,
+-        unsigned char   blue
+-    )
+-{
+-    switch(proto)
+-    {
+-        case RIVAL_100:
+-            SetColor(0, red, green, blue);
+-            break;
+-
+-        case RIVAL_300:
+-            SetColor(0, red, green, blue);
+-            SetColor(1, red, green, blue);
+-            break;
+-
+-        case RIVAL_650:
+-            for(int i = 0x10; i < 0x18; i++)
+-            {
+-                SetColor(i, red, green, blue);
+-            }
+-            break;
+-
+-        default:
+-            break;
+-    }
+-}
