+-void OpenRGBThemeManager::Init()
+-{
+-
+-#ifdef __APPLE__
+-    /*-------------------------------------------------*\
+-    | Apply Qt Fusion theme on MacOS, as the MacOS      |
+-    | default theme does not handle vertical tabs well  |
+-    \*-------------------------------------------------*/
+-    QApplication::setStyle(QStyleFactory::create("Fusion"));
+-#endif
+-    /*-------------------------------------------------*\
+-    | Apply dark theme if configured                    |
+-    \*-------------------------------------------------*/
