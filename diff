+-void SerialSettingsEntry::on_ProtocolComboBox_currentIndexChanged(int index)
+-{
+-    if(index == 3)
+-    {
+-        ui->BaudLabel->setText("Address:");
+-    }
+-    else
+-    {
+-        ui->BaudLabel->setText("Baud:");
+-    }
+-}
