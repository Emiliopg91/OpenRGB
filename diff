-{
-    unsigned char usb_buf[32];
-    memset(usb_buf, 0, sizeof(usb_buf));
-    int actual;
-
-    unsigned char led_enable = 0x01;
-
-    unsigned char rr = RGBGetRValue(colors[0]);
