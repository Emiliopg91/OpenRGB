+-    if(dev)
+-    {
+-        LightSaltController* controller     = new LightSaltController(dev, *info);
+-        RGBController*       rgb_controller = nullptr;
+-
+-        switch(controller->GetDeviceType())
+-        {
+-            case LIGHTSALT_TYPE_KEYBOARD:
