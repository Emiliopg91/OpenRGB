+-void OpenRGBPluginsPage::on_PluginsList_PluginsDropped(std::vector<std::string> path_list)
+-{
+-    bool installed = false;
+-
+-    for(const std::string& file_path: path_list)
+-    {
+-        installed |= InstallPlugin(file_path);
+-    }
+-
+-    if(installed)
+-    {
+-        RefreshList();
+-    }
+-}
