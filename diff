+-void RGBController_HyperXAlloyElite2::KeepaliveThreadFunction()
+-{
+-    while(keepalive_thread_run)
+-    {
+-        if(active_mode == 0)
+-        {
+-            if((std::chrono::steady_clock::now() - last_update_time) > std::chrono::milliseconds(1000))
+-            {
+-                UpdateLEDs();
+-            }
+-        }
+-        std::this_thread::sleep_for(50ms);
+-    }
+-}
