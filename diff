-void RGBController_QMKOpenRGBRevE::PlaceLEDsInMaps
-    (
-        std::set<int>               unique_rows,
-        std::set<int>               /*unique_cols*/,
-        unsigned int                divisor,
-        std::vector<point_t>        led_points,
-        std::vector<unsigned int>   led_flags,
