+-void RGBController_HyperXAlloyElite::DeviceUpdateLEDs()
+-{
+-    last_update_time = std::chrono::steady_clock::now();
+-
+-    if(active_mode == 0)
+-    {
+-        controller->SetLEDsDirect(colors);
+-    }
+-    else
+-    {
+-        controller->SetLEDs(colors);
+-    }
+-}
