-/*---------------------------------------------------------*\
-| common_main                                               |
-|                                                           |
-|   Common entry functionality after determining whether we |
-|   were started as a service or not.                       |
-\*---------------------------------------------------------*/
-static int common_main(int argc, char* argv[])
-{
