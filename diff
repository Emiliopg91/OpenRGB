+-LenovoK510Controller::LenovoK510Controller(hid_device* dev_handle, const hid_device_info& info, std::string dev_name)
+-{
+-    device      = dev_handle;
+-    location    = info.path;
+-    name        = dev_name;
+-}
+-
+-LenovoK510Controller::~LenovoK510Controller()
+-{
+-    hid_close(device);
+-}
