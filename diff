+-    { 0x7B18, 6,  &zones_set1 },        // MAG Z390 TOMAHAWK
+-    { 0x7B50, 6,  &zones_set2 },        // MPG Z390M GAMING EDGE AC
+-    { 0x7B85, 7,  &zones_set0 },        // B450 GAMING PRO CARBON
+-    { 0x7B92, 10, &zones_set0 },        // MEG X399 CREATION
