+-SteelSeriesOldApexController::SteelSeriesOldApexController
+-    (
+-    hid_device*         dev_handle,
+-    steelseries_type    proto_type,
+-    const char*         path,
+-    std::string         dev_name
+-    )
+-{
+-    dev         = dev_handle;
+-    location    = path;
+-    name        = dev_name;
+-    proto       = proto_type;
+-}
