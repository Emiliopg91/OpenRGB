-            zones[zone_idx].type    = ZONE_TYPE_SINGLE;
-        }
-
-        zones[zone_idx].matrix_map  = NULL;
-    }
-
-    /*---------------------------------------------------------*\
-    | Create LED entries for each zone                          |
-    \*---------------------------------------------------------*/
-    unsigned int led_idx = 0;
-    for(std::size_t zone_idx = 0; zone_idx < zones.size(); zone_idx++)
