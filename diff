+-    razer_report report;
+-
+-    switch(matrix_type)
+-    {
+-        case RAZER_MATRIX_TYPE_STANDARD:
+-        case RAZER_MATRIX_TYPE_LINEAR:
+-            report                          = razer_create_mode_static_standard_matrix_report(RAZER_STORAGE_NO_SAVE, dev_led_id, red, grn, blu);
