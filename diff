+-        case MODE_DIRECTION_RIGHT:
+-            return 0x00;
+-        case MODE_DIRECTION_UP:
+-            return 0x20;
+-        case MODE_DIRECTION_DOWN:
+-            return 0x30;
+-        default:
+-            return 0x00;
+-    }
