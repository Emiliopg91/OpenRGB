+-
+-    /*-----------------------------------------------------*\
+-    | Zero out buffer                                       |
+-    \*-----------------------------------------------------*/
+-    memset(usb_buf, 0x00, sizeof(usb_buf));
+-
+-    //5A 3A 09 0A 00 03 01 01 FF BB GG RR
+-    usb_buf[0x01]           = 0x5A;
+-    usb_buf[0x02]           = 0x3A;
+-    usb_buf[0x03]           = 0x09;
+-    usb_buf[0x04]           = 0x0A;
