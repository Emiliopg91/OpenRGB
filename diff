+-            this->pci_vendor           = ven_id;
+-            this->pci_device           = dev_id;
+-            this->pci_subsystem_vendor = sbv_id;
+-            this->pci_subsystem_device = sbd_id;
+-            this->port_id              = 1;
+-            strcpy(this->device_name, "AMD ADL");
+-        }
+-    }
