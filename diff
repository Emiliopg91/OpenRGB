+-void RGBController_DMX::SetupZones()
+-{
+-    /*-----------------------------------------*\
+-    | Add Zones                                 |
+-    \*-----------------------------------------*/
+-    for(std::size_t zone_idx = 0; zone_idx < devices.size(); zone_idx++)
+-    {
+-        zone led_zone;
