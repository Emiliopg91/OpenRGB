-
-    LOG_DEBUG("%sAdding modes", WOOTING_CONTROLLER_NAME);
-    mode Direct;
-    Direct.name         = "Direct";
-    Direct.value        = 0xFFFF;
-    Direct.flags        = MODE_FLAG_HAS_PER_LED_COLOR;
-    Direct.color_mode   = MODE_COLORS_PER_LED;
-    modes.push_back(Direct);
-
-    SetupZones();
