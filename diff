+-void MSIGPUv2Controller::MSIGPUBlockWrite(unsigned char reg, unsigned char *val, unsigned char len)
+-{
+-    bus->i2c_smbus_interface::i2c_smbus_write_i2c_block_data(dev, reg, len, val);
+-    std::this_thread::sleep_for(20ms);
+-}
