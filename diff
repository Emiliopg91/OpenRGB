+-    Direct.flags                    = MODE_FLAG_HAS_PER_LED_COLOR | MODE_FLAG_HAS_BRIGHTNESS | MODE_FLAG_HAS_SPEED | MODE_FLAG_MANUAL_SAVE;
+-    Direct.color_mode               = MODE_COLORS_PER_LED;
+-    modes.push_back(Direct);
+-
+-    mode Breathing;
