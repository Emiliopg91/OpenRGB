-void LogitechG203LController::SetMode(
-    int             mode,
-    int             speed,
-    unsigned char   bright,
-    unsigned char   dir,
-    unsigned char   red,
-    unsigned char   green,
-    unsigned char   blue)
-{
-    unsigned char usb_buf[PACKET_SIZE];
-    unsigned char brightness = bright * 5;
-
-    if(brightness == 0)
-    {
-        brightness = 1;
-    }
-
-    memset(usb_buf, 0x00, PACKET_SIZE);
-
-    //Header
-    usb_buf[0x00] = 0x11;
-    usb_buf[0x01] = 0xFF;
-    usb_buf[0x02] = 0x0E;
-    usb_buf[0x03] = 0x10;
