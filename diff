+-std::string AutoStart::GetExePath()
+-{
+-    /*-----------------------------------------------------*\
+-    | Create the OpenRGB executable path                    |
+-    \*-----------------------------------------------------*/
+-    char exepath[MAX_PATH] = "";
+-
+-    DWORD count = GetModuleFileNameA(NULL, exepath, MAX_PATH);
+-
+-    return(std::string(exepath, (count > 0) ? count : 0));
+-}
