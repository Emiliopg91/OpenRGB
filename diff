+-void HuePlusController::Initialize(char* port)
+-{
+-    port_name = port;
+-
+-    serialport = new serial_port(port_name.c_str(), HUE_PLUS_BAUD);
+-
+-    channel_leds[HUE_PLUS_CHANNEL_1_IDX] = GetLEDsOnChannel(HUE_PLUS_CHANNEL_1);
