+-void scsi_free_enumeration(struct scsi_device_info * devs)
+-{
+-	struct scsi_device_info * dev       = devs;
+-
+-	while(dev)
+-    {
+-		struct scsi_device_info * next  = dev->next;
+-
+-		free(dev->path);
+-		free(dev->vendor);
+-		free(dev->product);
+-		free(dev);
+-
+-		dev = next;
+-	}
