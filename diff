+-        ui->ComboBoxAutoStartProfile->blockSignals(false);
+-        ui->ComboBoxSuspendProfile->blockSignals(false);
+-        ui->ComboBoxResumeProfile->blockSignals(false);
+-        ui->ComboBoxExitProfile->blockSignals(false);
