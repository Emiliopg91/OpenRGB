+-void NanoleafScanDialog::on_NanoleafDeviceList_itemSelectionChanged()
+-{
+-    int cur_row = ui->NanoleafDeviceList->currentRow();
+-
+-    bool anySelected = (cur_row >= 0);
+-    ui->RemoveNanoleafDeviceButton->setEnabled(anySelected);
+-}
