+-
+-    /*-----------------------------------------------------*\
+-    | Convert to std::string                                |
+-    \*-----------------------------------------------------*/
+-    std::string name = StringUtils::wstring_to_string(tname);
+-
+-    /*-----------------------------------------------------*\
+-    | Get the product string from HID                       |
+-    \*-----------------------------------------------------*/
+-    hid_get_product_string(dev, tname, 256);
+-
+-    /*-----------------------------------------------------*\
