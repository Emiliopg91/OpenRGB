+-    usb_buf[0x02]           = 0x3A;
+-    usb_buf[0x03]           = 0x06;
+-    usb_buf[0x04]           = 0x04;
+-    usb_buf[0x06]           = 0x03;
+-    usb_buf[0x07]           = 0x01;
+-    usb_buf[0x09]           = 0x01;
+-
+-    /*-----------------------------------------------------*\
