+-void RGBController_LenovoUSB::UpdateSingleLED(int led)
+-{
+-    if(led != (int)NA)
+-    {
+-        controller->setSingleLED(leds[led].value >> 8, leds[led].value & 0xFF, colors[led]);
+-    }
+-}
