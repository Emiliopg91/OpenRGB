+-{
+-
+-}
+-
+-void RGBController_CorsairK65Mini::KeepaliveThread()
+-{
+-    while(keepalive_thread_run.load())
+-    {
+-        if((std::chrono::steady_clock::now() - last_update_time) > std::chrono::milliseconds(50000))
+-        {
+-            DeviceUpdateLEDs();
+-        }
+-
+-        std::this_thread::sleep_for(3000ms);
+-    }
+-}
