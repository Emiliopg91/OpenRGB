-                /*---------------------------------------------------------*\
-                | Set zone name to channel name                             |
-                \*---------------------------------------------------------*/
-                new_zone->name = controller->GetChannelName(cfg_zone_idx);
-
-                /*---------------------------------------------------------*\
-                | Set zone LED count to LEDs in zone                        |
-                \*---------------------------------------------------------*/
-                new_zone->leds_count = leds_in_zone;
