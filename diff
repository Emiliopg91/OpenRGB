-        zones.push_back(zone);
-    }
-
-    for(int led_idx = 0; led_idx < table.led.count; led_idx++)
-    {
-        led led;
-        led.name = table.led.names[led_idx];
-        leds.push_back(led);
-    }
-
-    {
