+-void VS_XG270QG_Controller::SetMode(uint8_t mode1, uint8_t r1, uint8_t g1, uint8_t b1, uint8_t mode2, uint8_t r2, uint8_t g2, uint8_t b2)
+-{
+-    SendModeComplete(mode1, r1, g1, b1, mode2, r2, g2, b2);
