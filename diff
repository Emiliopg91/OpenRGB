+-        else
+-        {
+-            direction = GLORIOUS_DIRECTION_UP;
+-        }
+-
+-        if ((modes[active_mode].speed == GLORIOUS_SPEED_FAST)   ||
+-            (modes[active_mode].speed == GLORIOUS_SPEED_SLOW)   ||
