+-    @name Coolermaster RGB
+-    @category LEDStrip
+-    @type USB
+-    @save :robot:
+-    @direct :x:
+-    @effects :white_check_mark:
+-    @detectors DetectCoolerMasterRGB
+-    @comment This is a 12V analogue RGB controller only.
+-\*-------------------------------------------------------------------*/
