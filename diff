+-    vendor      = "Metadot";
+-    type        = DEVICE_TYPE_KEYBOARD;
+-    description = "Das Keyboard Device";
+-    location    = controller->GetLocationString();
+-    serial      = controller->GetSerialString();
+-    version     = controller->GetVersionString();
+-
+-    modes.resize(4);
+-    modes[0].name       = "Direct";
