-void RoccatKoneXPController::WaitUntilReady()
-{
-    uint8_t buf[4];
-    memset(buf, 0x00, 4);
-
-    buf[0] = 0x04;
-
-    for(unsigned char i = 0; buf[1] != 1 && i < 100; i++)
-    {
-        if(i != 0)
-        {
-            std::this_thread::sleep_for(std::chrono::milliseconds(200));
-        }
-
-        hid_get_feature_report(dev, buf, 4);
-    }
-}
