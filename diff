-uint16_t SkyloongGK104ProController::Crc16CcittFalse(const uint8_t *buffer, uint16_t size)
-{
-    uint16_t crc = 0xFFFF;
-
-    while(size--)
-    {
-        crc ^= (*buffer++ << 8);
-
-        for(uint8_t i = 0; i < 8; ++i)
-        {
-            if(crc & 0x8000)
-            {
-                crc = (crc << 1) ^ 0x1021;
-            }
-            else
-            {
-                crc = crc << 1;
-            }
-        }
-    }
-
-    return crc;
-}
