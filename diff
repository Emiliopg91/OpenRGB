-        Mode.brightness      = MSI_BRIGHTNESS_LEVEL_100;
-        Mode.brightness_max  = MSI_BRIGHTNESS_LEVEL_100;
-        Mode.brightness_min  = MSI_BRIGHTNESS_OFF;
