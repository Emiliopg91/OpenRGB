+-void OpenRGBSettingsPage::UpdateProfiles()
+-{
+-    /*---------------------------------------------------------*\
+-    | Load AutoStart settings                                   |
+-    \*---------------------------------------------------------*/
+-    ProfileManager* profile_manager = ResourceManager::get()->GetProfileManager();
+-
+-    /*---------------------------------------------------------*\
+-    | Load profiles into combo box                              |
+-    \*---------------------------------------------------------*/
