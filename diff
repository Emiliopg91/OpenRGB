+-    led_zone.type       = ZONE_TYPE_SINGLE;
+-    led_zone.leds_min   = 1;
+-    led_zone.leds_max   = 1;
+-    led_zone.leds_count = 1;
+-    led_zone.matrix_map = NULL;
+-    zones.push_back(led_zone);
+-
+-    led new_led;
+-    new_led.name        = "RGB Light";
+-
+-    leds.push_back(new_led);
+-
+-    SetupColors();
+-}
