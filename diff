-                last_resizable_zone = zd->zone_type;
-                new_zone.flags     |= ZONE_FLAG_RESIZE_EFFECTS_ONLY;
-            }
-            /*--------------------------------------------------\
-            | This is a resizable zone on a board that does     |
-            | support per-LED direct mode                       |
-            \*-------------------------------------------------*/
-            else
-            {
-                new_zone.leds_min   = 0;
-                new_zone.leds_max   = maxLeds;
