+-        bus->i2c_smbus_write_byte_data(dev, ACX30_REG_22, 0xCE);
+-    }
+-    else
+-    {
+-        bus->i2c_smbus_write_byte_data(dev, ACX30_REG_21, 0xE5);
+-        bus->i2c_smbus_write_byte_data(dev, ACX30_REG_22, 0xE7);
