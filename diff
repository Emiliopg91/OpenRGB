-    else
-    {
-        /*-------------------------------------------------*\
-        | No console, no logmanager, no eventlog, no more   |
-        | ideas. Sometimes it's OK to give up.              |
-        \*-------------------------------------------------*/
-    }
-
-    /*-----------------------------------------------------*\
-    | Free the buffer                                       |
-    \*-----------------------------------------------------*/
-    free(buf);
-}
