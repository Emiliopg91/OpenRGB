+-{
+-    unsigned char usb_buf[65];
+-
+-    /*-----------------------------------------------------*\
+-    | Zero out buffer                                       |
+-    \*-----------------------------------------------------*/
+-    memset(usb_buf, 0x00, sizeof(usb_buf));
+-
+-    /*-----------------------------------------------------*\
+-    | Set up Morph Mode packet                              |
+-    \*-----------------------------------------------------*/
+-    usb_buf[0x00]           = 0x00;
+-    usb_buf[0x01]           = 0x05;
+-    usb_buf[0x02]           = 0x01;
+-    usb_buf[0x03]           = mode;
+-    usb_buf[0x04]           = red1;
+-    usb_buf[0x05]           = green1;
+-    usb_buf[0x06]           = blue1;
+-    usb_buf[0x07]           = red2;
+-    usb_buf[0x08]           = green2;
+-    usb_buf[0x09]           = blue2;
+-    usb_buf[0x0E]           = 0x02;
+-    usb_buf[0x0A]           = speed;
+-    usb_buf[0x0B]           = 0x0A;
+-    usb_buf[0x0D]           = 0x01;
+-    usb_buf[0x0E]           = ALIENWARE_AW510K_TWO_USER_DEFINED_COLOR_MODE;
+-
+-    /*-----------------------------------------------------*\
+-    | Send packet                                           |
+-    \*-----------------------------------------------------*/
+-    hid_write(dev, usb_buf, 65);
+-}
