+-void RGBController_E131::KeepaliveThreadFunction()
+-{
+-    while(keepalive_thread_run.load())
+-    {
+-        if((std::chrono::steady_clock::now() - last_update_time) > ( keepalive_delay * 0.95f ) )
+-        {
+-            UpdateLEDs();
+-        }
+-        std::this_thread::sleep_for(keepalive_delay / 2);
+-    }
+-}
