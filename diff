-void LIFXController::HeaderPacketSetProtocol(unsigned short protocol)
-{
-    data[LIFX_HEADER_PACKET_OFFSET_PROTOCOL] = protocol & 0xFF;
-    unsigned char current = data[LIFX_HEADER_PACKET_OFFSET_ADDRESSABLE_TAGGED_ORIGIN];
