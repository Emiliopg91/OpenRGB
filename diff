+-VectorMatrix RGBController_QMKOpenRGBRev9::MakeEmptyMatrixMap
+-    (
+-        std::size_t height,
+-        std::size_t width
+-    )
+-{
+-    std::vector<std::vector<unsigned int> > matrix_map(height);
+-    for(std::size_t i = 0; i < height; i++)
+-    {
+-        for(std::size_t j = 0; j < width; j++)
+-        {
+-            matrix_map[i].push_back(NO_LED);
+-        }
+-    }
+-    return matrix_map;
+-}
