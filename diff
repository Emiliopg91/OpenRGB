+-        }
+-        else if(NUM_CHANNELS == 10 || NUM_CHANNELS == 12)
+-        {
+-            snprintf(ch_idx_string, 4, "%d", channel_idx+1 );
+-            zones[channel_idx].name     = "Channel ";
+-        }
+-        else if(NUM_CHANNELS == 14)
+-        {
+-            if(channel_idx<4)
+-            {
+-                snprintf(ch_idx_string, 2, "%d", channel_idx+1 );
+-                zones[channel_idx].name     = "LCD ";
