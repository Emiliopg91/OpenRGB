+-void HyperXMicrophoneController::SaveColors(std::vector<RGBColor> colors, unsigned int num_frames)
+-{
+-    unsigned int  num_color_packets                     = 0;
+-    unsigned int  frame                                 = 0;
+-    unsigned char color[HYPERX_QUADCAST_S_PACKET_SIZE]  = {0};
