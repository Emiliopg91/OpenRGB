+-                    0x01, 0x10, 0x08, 0x01, 0x10, 0x00, 0x00, 0x00,
+-                    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
+-                };
+-                SendCommand(data);
