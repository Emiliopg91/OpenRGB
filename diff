+-void RGBController_JGINYUEInternalUSB::ResizeZone(int zone, int new_size)
+-{
+-    unsigned char area;
+-
+-    switch(zone)
+-    {
+-    case 0:
+-        area = 0x01;
+-        break;
+-    case 1:
+-        area = 0x02;
+-        break;
+-    default:
+-        area = 0x01;
+-        break;
+-    }
+-
+-    zones[zone].leds_count = new_size;
+-
+-    SetupZones();
+-
+-    controller->Area_resize(new_size, area);
+-}
