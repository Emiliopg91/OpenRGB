+-void NZXTHue2Controller::SendFan
+-    (
+-        unsigned char       port,
+-        unsigned char       /*mode*/,
+-        unsigned char       speed
+-    )
+-{
+-    unsigned char usb_buf[64];
+-
+-    /*-----------------------------------------------------*\
+-    | Zero out buffer                                       |
+-    \*-----------------------------------------------------*/
+-    memset(usb_buf, 0x00, sizeof(usb_buf));
+-
+-    /*-----------------------------------------------------*\
+-    | Set up RGB packet                                     |
+-    \*-----------------------------------------------------*/
+-    usb_buf[0x00]   = 0x62;
+-    usb_buf[0x01]   = 0x01;
+-    usb_buf[0x02]   = 1 << port;
+-    usb_buf[port + 3] = speed;
+-
+-    /*-----------------------------------------------------*\
+-    | Send packet                                           |
+-    \*-----------------------------------------------------*/
+-    hid_write(dev, usb_buf, 64);
+-    hid_read(dev, usb_buf, 64);
+-}
