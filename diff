+-    memset(buf, 0x00, sizeof(buf));
+-
+-    /*-----------------------------------------------------*\
+-    | Set up Select Profile packet                          |
+-    \*-----------------------------------------------------*/
+-    buf[0x00]   = 0x07;
+-    buf[0x01]   = 0x01;
+-    buf[0x02]   = profile;
+-
+-    buf[0x06]   = 0x03;
+-    buf[0x07]   = 0x01;
+-
