-
-    memset(buffer, 0, HYPERX_QUADCAST_S_PACKET_SIZE);
-
-    buffer[0x01]    = 0x04;
-    buffer[0x02]    = reg;         // 0xF2 Apply, 0x53 Save
-    buffer[0x08]    = param1;
-    buffer[0x09]    = param2;
-
-    wrapper.hid_send_feature_report(dev, buffer, HYPERX_QUADCAST_S_PACKET_SIZE);
