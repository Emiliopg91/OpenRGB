-
-    if(dev)
-    {
-        LOG_DEBUG("Adding Usage %i for device @ path %s", info->usage, info->path);
-        device_usages.emplace((uint8_t)info->usage, dev);
-    }
-    else
-    {
-        LOG_DEBUG("Error opening Usage %i for device @ path %s", info->usage, info->path);
