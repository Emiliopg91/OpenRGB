-        usb_buf[0x40] = CalculateFinalByte(usb_buf, 0x0C);
-        break;
-    case M300_MODE_OFF:
-    default:
-        usb_buf[0x06] = 0x03;
-        usb_buf[0x40] = 0x36;
-    }
-    hid_write(device, usb_buf, M300_DATA_SIZE);
