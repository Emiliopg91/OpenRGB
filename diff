-            default:
-                controller->SetLedColors(channel, nullptr, 0);
-                break;
-        }
-
-        controller->SetLedMode(channel, modes[active_mode].value);
-
-        if(modes[active_mode].flags & MODE_FLAG_HAS_SPEED)
