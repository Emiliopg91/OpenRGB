-
-	usb_buf[0x07] = RGBGetBValue(rgb);
-	usb_buf[0x08] = speed;
-	usb_buf[0x09] = 0xFF;
-	usb_buf[0x10] = allzone;
-
-    /*-----------------------------------------------------*\
-    | Send packet                                           |
-    \*-----------------------------------------------------*/
-    hid_write(dev, usb_buf, 65);
