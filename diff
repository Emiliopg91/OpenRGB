+-    // Calculate start index and size
+-    for(unsigned int z_idx = 0; z_idx < zones.size(); z_idx++)
+-    {
+-        if(z_idx == (unsigned int)zone)
+-        {
+-            zone_size = zones[z_idx].leds_count;
