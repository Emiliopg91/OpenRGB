+-    )
+-{
+-    unsigned char data[6];
+-
+-    memcpy(&data[0], &mode, sizeof(unsigned short));
+-
+-    data[2] = speed;
+-    data[3] = hue;
+-    data[4] = sat;
+-    data[5] = val;
+-
+-    SendCommand(CMD_LIGHTING_SET_VALUE, VIALRGB_SET_MODE, data, sizeof(data), NULL, 0);
+-}
