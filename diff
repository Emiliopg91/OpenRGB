+-int RGBController_EVGAGPUv2::getModeIndex(unsigned char mode_value)
+-{
+-    for(int mode_index = 0; mode_index < (int)modes.size(); mode_index++)
+-    {
+-        if(modes[mode_index].value == mode_value)
+-        {
+-            return(mode_index);
+-        }
+-    }
+-
+-    return(0);
+-}
