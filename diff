+-s32 i2c_smbus_nct6775::i2c_smbus_xfer(u8 addr, char read_write, u8 command, int size, i2c_smbus_data* data)
+-{
+-    s32 result = nct6775_access(addr, read_write, command, size, data);
+-
+-    return result;
+-}
