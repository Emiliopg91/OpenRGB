+-void CMMMController::SendSavePacket()
+-{
+-    unsigned char buffer[CM_MM_PACKET_SIZE]  = { 0x00, 0x50, 0x55 };
+-
+-    hid_write(dev, buffer, CM_MM_PACKET_SIZE);
+-    hid_read_timeout(dev, buffer, CM_MM_PACKET_SIZE, CM_MM_INTERRUPT_TIMEOUT);
+-}
