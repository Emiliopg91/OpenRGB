+-
+-    new_zone->name          = "GPU";
+-    new_zone->type          = ZONE_TYPE_SINGLE;
+-    new_zone->leds_min      = 1;
+-    new_zone->leds_max      = 1;
+-    new_zone->leds_count    = 1;
+-    new_zone->matrix_map    = NULL;
+-    zones.push_back(*new_zone);
+-
+-    /*---------------------------------------------------------*\
+-    | This device can control up to 12 LEDs                     |
+-    | For now all LEDs show the same color                      |
+-    \*---------------------------------------------------------*/
+-    led* new_led            = new led();
