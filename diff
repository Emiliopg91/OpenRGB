-        color_buf[offset + 0] = RGBGetRValue(colors[i]);
-        color_buf[offset + 1] = RGBGetBValue(colors[i]);
-        color_buf[offset + 2] = RGBGetGValue(colors[i]);
-    }
-
-    while(bytes_sent < (XTREEM_LED_COUNT * 3))
