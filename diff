+-uint8_t RGBController_ASRockPolychromeV1SMBus::getModeIndex(uint8_t mode_value)
+-{
+-    for(uint8_t mode_index = 0; mode_index < modes.size(); mode_index++)
+-    {
+-        if (modes[mode_index].value == mode_value)
+-        {
+-            return mode_index;
+-        }
+-    }
+-    return 0;
+-}
