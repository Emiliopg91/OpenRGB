+-#define QMK_OPENRGB_PROTOCOL_VERSION_9          0x09
+-#define QMK_OPENRGB_PROTOCOL_VERSION_B          0x0B
+-#define QMK_OPENRGB_PROTOCOL_VERSION_C          0x0C
+-#define QMK_OPENRGB_PROTOCOL_VERSION_D          0x0D
