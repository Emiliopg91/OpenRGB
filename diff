-    {
-        response[1] &= ~0x80; // Clear response flag
-        response[2] = request[2];
-        response[3] = request[3];
-        response[4] = request[4];
-        response[5] = request[5];
-        memcpy(buf,response,PAYLOAD_LEN);
-        read_config_error = false;
-        return true;
