-void RedSquareKeyroxController::SetMode(std::vector<mode> modes, int active_mode)
-{
-    /*---------------------------------------------*\
-    |  Mode set command                             |
-    \*---------------------------------------------*/
-    mode m = modes[active_mode];
-
-    unsigned char usb_buf[PACKET_DATA_LENGTH];
-    memset(usb_buf, 0x00, PACKET_DATA_LENGTH);
-
