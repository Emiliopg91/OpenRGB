+-uint8_t RoccatKoneXPController::GetActiveProfile()
+-{
+-    uint8_t buf[4] = { 0x05 };
+-    int return_length = hid_get_feature_report(dev, buf, 4);
+-
+-    if(return_length == -1)
+-    {
+-        LOG_DEBUG("[Roccat Kone XP]: Could not fetch active profile. HIDAPI Error: %ls", hid_error(dev));
+-        return 0;
+-    }
+-
+-    return buf[2];
+-}
