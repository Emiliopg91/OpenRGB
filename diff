+-
+-        if(devices[device_idx].blue_channel > 0)
+-        {
+-            dmx_data[devices[device_idx].blue_channel]       = RGBGetBValue(colors[device_idx]);
+-        }
+-    }
+-
+-    port->serial_break();
+-    port->serial_write((char*)&dmx_data, sizeof(dmx_data));
