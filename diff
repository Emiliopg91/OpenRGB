+-base64::byte CalculateXorChecksum(std::vector<base64::byte> packet)
+-{
+-    base64::byte checksum = 0;
+-
+-    for(unsigned int i = 0; i < packet.size(); i++)
+-    {
+-        checksum ^= packet[i];
+-    }
+-
+-    return(checksum);
+-}
