-        buffer[6] = RGBGetBValue(colors[led_index]);
-
-        /*--------------------------------------*\
-        | calculate the last checksum byte       |
-        \*--------------------------------------*/
-        unsigned char xor_value = 0;
-
-        for(int i = 0; i < 63; ++i)
-        {
-            xor_value ^= buffer[i];
-        }
-
-        if(xor_value % 2 == 0)
-        {
-            buffer[63] = (xor_value + 1) % 256;
-        }
-        else
-        {
-            buffer[63] = (xor_value - 1) % 256;
-        }
