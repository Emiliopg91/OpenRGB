+-void RGBController_CMARGBController::DeviceUpdateLEDs()
+-{
+-    uint8_t end_zone = last_zone(cmargb->GetZoneIndex());
+-
+-    for(int zone_idx = first_zone(cmargb->GetZoneIndex()); zone_idx < end_zone; zone_idx++)
+-    {
+-        UpdateZoneLEDs(zone_idx);
+-    }
+-}
