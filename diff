-    unsigned int tmp_leds_per_update = leds_per_update;
-
-    while (leds_sent < leds_count)
-    {
-        if ((leds_count - leds_sent) < tmp_leds_per_update)
-        {
-            tmp_leds_per_update = leds_count - leds_sent;
