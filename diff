+-static void send_usb_msg(hid_device* dev, char * data_pkt, unsigned int size)
+-{
+-    char* usb_pkt = new char[size + 1];
+-
+-    usb_pkt[0] = 0x00;
+-    for(unsigned int i = 1; i < size + 1; i++)
+-    {
+-        usb_pkt[i] = data_pkt[i-1];
+-    }
+-
+-    hid_write(dev, (unsigned char *)usb_pkt, size + 1);
+-
+-    delete[] usb_pkt;
+-}
