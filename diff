+-    unsigned int zone_count = controller->GetZoneCount();
+-
+-    /*---------------------------------------------------------*\
+-    | If there is only one zone, set up a single LED            |
+-    \*---------------------------------------------------------*/
+-    if(zone_count <= 1)
+-    {
+-        led_zone.name       = "RGB Light";
+-        led_zone.type       = ZONE_TYPE_SINGLE;
+-        led_zone.leds_min   = 1;
+-        led_zone.leds_max   = 1;
