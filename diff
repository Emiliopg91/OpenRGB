-    /*-----------------------------------------------------*\
-    | Send packet                                           |
-    \*-----------------------------------------------------*/
-    libusb_bulk_transfer(dev, 0x01, usb_buf, 1, &actual, 1000);
-    libusb_bulk_transfer(dev, 0x81, usb_buf, 7, &actual, 1000);
