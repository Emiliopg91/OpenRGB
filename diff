+-                new_zone.name                   = zone_names[zone_idx];
+-            }
+-            break;
+-
+-            case GAIZHONGGAI_42_PRO_PID:
+-            {
+-                new_zone.type                   = ZONE_TYPE_MATRIX;
+-                new_zone.leds_min               = 42;
+-                new_zone.leds_max               = 42;
+-                new_zone.leds_count             = 42;
