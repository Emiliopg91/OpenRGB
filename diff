+-    \*-----------------------------------------------------*/
+-
+-    usb_buf[0x00] = 0x00;
+-    usb_buf[0x01] = QMK_OPENRGB_DIRECT_MODE_SET_SINGLE_LED;
+-    usb_buf[0x02] = led;
+-    usb_buf[0x03] = red;
