-uint8_t RGBController_LianLiUniHub::convertLedCountToFanCount(uint8_t count)
-{
-    /*-------------------------------------------------*\
-    | Converts 0 to 0, 1-16 to 1, 17-32 to 2, 33-48 to  |
-    | 3  and 49-64+ to 4                                |
-    \*-------------------------------------------------*/
-    if (count == 0x00)
-    {
-        return 0x00;
-    }
-    if (count >= 0x40)
-    {
-        count = 0x40;
-    }
-
-    return((count -1) / 16 + 1);
-}
