+-    buffer[2]=red;
+-    buffer[1]=green;
+-    buffer[0]=blue;
+-    MSIGPUBlockWrite(MSI_GPU_V2_REG_COLOR_BLOCK3_BASE, &buffer[0], sizeof(buffer));
+-}
