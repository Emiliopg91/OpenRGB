+-void ManualDevicesSettingsPage::onAddDeviceItemSelected(QAction* action)
+-{
+-    /*---------------------------------------------------------*\
+-    | Spawn new entry based on name                             |
+-    \*---------------------------------------------------------*/
+-    std::string             entryName   = action->data().toString().toStdString();
