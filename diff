-    bool first_run = false;
-
-    if(zones.size() == 0)
-    {
-        first_run = true;
-    }
-
-    if(first_run)
-    {
-        /*---------------------------------------------------------*\
-        | Set up zones                                              |
-        \*---------------------------------------------------------*/
-        for(std::size_t zone_idx = 0; zone_idx < zone_description.size(); ++zone_idx)
-        {
-            const ZoneDescription* zd = zone_description[zone_idx];
-
-            zone new_zone;
