+-void RoccatHordeAimoController::InitialPacket()
+-{
+-    unsigned char usb_buf[8];
+-
+-    memset(usb_buf, 0x00,8);
+-
+-    usb_buf[0x00] = 0x13;
+-    usb_buf[0x01] = 0x08;
