-
-    float angle;
-    uint16_t led_len = 0;
-    uint8_t offset = 0;
-
-    angle = ((21 - p_in[121]) % 12) * acosf(-1.0f) / 6;
-
-    board_led_xy_self_call(p_in, &offset,matrix_map_light_board , &led_len, 0, 0, 0, angle);
-
-    return led_len;
