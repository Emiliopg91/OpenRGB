+-std::vector<uint8_t> CMKeyboardV1Controller::GetEnabledEffects()
+-{
+-    std::vector<uint8_t> data;
+-
+-    data = SendCommand({0x52, 0x29});
+-
+-    std::vector<uint8_t> effects;
+-
+-    for(size_t i = 4; data[i] != 0xFF; i++)
+-    {
+-        effects.push_back(data[i]);
+-    }
+-
+-    return effects;
+-}
