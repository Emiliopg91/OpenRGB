+-void RGBController_EVGAACX30SMBus::UpdateSingleLED(int led)
+-{
+-    unsigned char red = RGBGetRValue(colors[led]);
+-    unsigned char grn = RGBGetGValue(colors[led]);
+-    unsigned char blu = RGBGetBValue(colors[led]);
