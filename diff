-
-    hid_write(dev, usb_buf, CORSAIR_PERIPHERAL_PACKET_LENGTH);
-
-    /*-----------------------------------------------------*\
-    | Send "lght_00.d"                                      |
-    \*-----------------------------------------------------*/
-    memset(usb_buf, 0x00, CORSAIR_PERIPHERAL_PACKET_LENGTH);
-
-    usb_buf[1]  = CORSAIR_COMMAND_WRITE;
-    usb_buf[2]  = 0x17;
-    usb_buf[3]  = 0x05;
-    usb_buf[5]  = 0x6c;
-    usb_buf[6]  = 0x67;
-    usb_buf[7]  = 0x68;
