+-
+-void RGBController_CorsairWireless::KeepaliveThread()
+-{
+-    while(keepalive_thread_run.load())
+-    {
+-        if(active_mode == 0)
+-        {
+-            if((std::chrono::steady_clock::now() - last_update_time) > std::chrono::milliseconds(5000))
+-            {
+-                DeviceUpdateLEDs();
+-            }
+-        }
+-        std::this_thread::sleep_for(1000ms);
+-    }
+-}
