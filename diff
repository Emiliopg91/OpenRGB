-            controller->SetRegister(FURY_REG_BREATH_MID_TO_MAX,
-                                    modes[active_mode].speed);
-            controller->SetRegister(FURY_REG_BREATH_MAX_TO_MID,
-                                    modes[active_mode].speed);
-            controller->SetRegister(FURY_REG_BREATH_MID_TO_MIN,
