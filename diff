-void DetectLogitechLightspeedReceiver(hid_device_info* info, const std::string& /*name*/)
-{
-    /*-----------------------------------------------------------------*\
-    | Need to save the PID and the device path before iterating         |
-    |    over "info" in BundleLogitechUsages()                          |
