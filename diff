-    memset(usb_buf, 0x00, CORSAIR_PERIPHERAL_PACKET_LENGTH);
-
-    usb_buf[1] = CORSAIR_COMMAND_STREAM;
-    usb_buf[2] = 0x01;
-    usb_buf[3] = 0x0D;
-    usb_buf[5] = mode_value;
