+-
+-    /*-----------------------------------------------------*\
+-    | If geometry info doesn't exist, write it to config    |
+-    \*-----------------------------------------------------*/
+-    if(!ui_settings.contains("geometry"))
+-    {
+-        json geometry_settings;
+-
+-        geometry_settings["load_geometry"]  = false;
+-        geometry_settings["save_on_exit"]   = false;
