-            //Load 4 bytes into FIFO
-            cnt = 1;
-            if (len >= 4)
-            {
-                for (i = cnt; i <= 4; i++)
-                {
-                    WriteIoPortByte(SMBHSTDAT, data->block[i]);
-                }
-
-                len -= 4;
-                cnt += 4;
-            }
-            else
-            {
-                for (i = cnt; i <= len; i++)
-                {
-                    WriteIoPortByte(SMBHSTDAT, data->block[i]);
