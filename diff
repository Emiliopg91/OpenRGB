-        }
-        hid_write(dev, buffer, COUGARKEYBOARDCONTROLLER_WRITE_PACKET_SIZE);
-        std::this_thread::sleep_for(1ms);
-
-        /*-----------------------------------------------------------------*\
-        | After the first packet the packet flag should be 0x02             |
-        \*-----------------------------------------------------------------*/
-        buffer[packet_flag]     = 2;
