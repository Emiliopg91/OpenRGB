+-    unsigned char buffer[FUSION2_USB_BUFFER_SIZE];
+-    struct RGBData
+-    {
+-        uint8_t     report_id;
+-        uint8_t     header;
+-        uint16_t    boffset;
+-        uint8_t     bcount;
+-        LEDs        leds[19];
+-        uint16_t    padding0;
+-    } s;
+-
+-    PktRGB() : s {}
+-    {
+-    }
+-
+-    void Init(uint8_t header, uint8_t report_id)
+-    {
+-        switch(header)
+-        {
+-            case LED4:
+-            case HDR_D_LED2:
+-                header = HDR_D_LED2_RGB;
+-                break;
+-            case HDR_D_LED3:
+-                header = HDR_D_LED3_RGB;
+-                break;
+-            case HDR_D_LED4:
+-                header = HDR_D_LED4_RGB;
+-                break;
+-            default:
+-                header = HDR_D_LED1_RGB;
+-                break;
+-        }
+-        s.report_id = report_id;
+-        s.header    = header;
+-        s.boffset   = 0;
+-        s.bcount    = 0;
+-        memset(s.leds, 0, sizeof(s.leds));
+-    }
