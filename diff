+-    \*---------------------------------------------------------*/
+-}
+-
+-void RGBController_CorsairK65Mini::DeviceUpdateLEDs()
+-{
+-    last_update_time = std::chrono::steady_clock::now();
+-    controller->SetLEDs(colors, led_positions);
+-}
