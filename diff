+-void GigabyteAorusPCCaseController::SendColor(uint8_t red, uint8_t green, uint8_t blue)
+-{
+-    uint8_t usb_buf[9] = { 0x00, 0x01, 0xC8, red, green, blue, 0x08, 0x01, 0x00 };
