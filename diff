-HRESULT Wmi::query(std::string queryStr, std::vector<QueryObj>& queryVectorOut, const AdditionalFilters* filters)
-{
-    if (pSvc == nullptr)
-    {
-        return E_FAIL;
-    }
-
-    HRESULT hres;
-    int nIdx = 0;
-    IEnumWbemClassObject* pEnumerator = nullptr;
-
-    // Initialize COM. ------------------------------------------
-    hres = CoInitializeEx(0, COINIT_APARTMENTTHREADED);
