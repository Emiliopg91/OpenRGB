+-    int crc = 1;
+-
+-    for(int i = 0; i < COLORFUL_NON_COLOR_PACKET_LENGTH - 1; ++i)
+-    {
+-        crc += data_pkt[i];
+-    }
+-    crc &= 0xFF;
+-    crc = 256-crc;
+-
+-    data_pkt[COLORFUL_NON_COLOR_PACKET_LENGTH - 1] = crc & 0xFF;
+-
+-    bus->i2c_write_block(dev, COLORFUL_NON_COLOR_PACKET_LENGTH, data_pkt);
+-}
