-    {
-        usb_buf[6] = speed;
-    }
-
-    if(color_mode == MODE_COLORS_RANDOM)
-    {
-        usb_buf[7] = 0x01;
-    }
-    else if (color_mode == MODE_COLORS_MODE_SPECIFIC)
-    {
-        usb_buf[7] = 0x03;
-
-        usb_buf[10] = RGBGetRValue(colors[0]);
-        usb_buf[11] = RGBGetGValue(colors[0]);
