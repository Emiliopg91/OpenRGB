+-    Rainbow.flags                   = MODE_FLAG_HAS_BRIGHTNESS | MODE_FLAG_HAS_SPEED | MODE_FLAG_MANUAL_SAVE;
+-    Rainbow.color_mode              = MODE_COLORS_NONE;
+-    modes.push_back(Rainbow);
+-
+-    mode Sync;
