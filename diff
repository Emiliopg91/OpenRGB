-
-    HDEVINFO device_info_set = SetupDiGetClassDevs(
-        NULL,                             // No class GUID
-        TEXT("PCI"),                      // Enumerator
-        NULL,                             // No parent window
-        DIGCF_PRESENT | DIGCF_ALLCLASSES  // Only present devices
-    );
