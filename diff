-        usb_buf[0x0F] = RGBGetRValue(colors[1]);
-        usb_buf[0x10] = RGBGetGValue(colors[1]);
-        usb_buf[0x11] = RGBGetBValue(colors[1]);
-        usb_buf[0x40] = CalculateFinalByte(usb_buf, 0x12);
