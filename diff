+-void RGBController_EVGAMouse::DeviceUpdateLEDs()
+-{
+-    for(unsigned int i = 0; i < colors.size(); i++)
+-    {
+-        controller->SetLed(i, modes[active_mode].brightness, modes[active_mode].speed, colors[i]);
+-    }
