+-void RGBController_JGINYUEInternalUSB::UpdateZoneLEDs(int zone)
+-{
+-    unsigned char area;
+-
+-    switch(zone)
+-    {
+-    case 0:
+-        area = 0x01;
+-        break;
+-    case 1:
+-        area = 0x02;
+-        break;
+-    default:
+-        area = 0x01;
+-        break;
+-    }
+-
+-    controller->DirectLEDControl(zones[zone].colors,area);
