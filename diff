+-            | If the objectName is either of the SDK tabs   |
+-            | then translate tab text (TODO: improve        |
+-            | workaround)                                   |
+-            \*---------------------------------------------*/
+-            std::string label = ui->MainTabBar->widget(i)->objectName().toStdString();
+-
+-            if(label.substr(0,3) == "SDK")
