+-{
+-    for(int led_idx = zones[zone].leds_count - 1; led_idx >= 0; led_idx--)
+-    {
+-        UpdateLed(zone, led_idx);
+-    }
+-    controller->Update((modes[active_mode].flags & MODE_FLAG_AUTOMATIC_SAVE) != 0);
+-}
