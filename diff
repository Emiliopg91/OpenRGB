-    \*-----------------------------------------------------*/
-    usb_buf[0x00]           = 0x11;
-    usb_buf[0x01]           = 0xFF;
-    usb_buf[0x02]           = 0x04;
-
-    /*-----------------------------------------------------*\
-    | This packet sets speaker into direct mode.  This mode |
-    | is used by Lightsync Ambilight and Music Visualizer   |
-    | realtime effect.                                      |
-    \*-----------------------------------------------------*/
-    usb_buf[0x03]           = 0x3A;
-
-    /*-----------------------------------------------------*\
-    | Set up mode and speed                                 |
-    \*-----------------------------------------------------*/
-    usb_buf[0x04]           = zone;
-    usb_buf[0x05]           = mode;
