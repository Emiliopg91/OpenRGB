+-void RGBController_GalaxGPUv1::UpdateSingleLED(int /*led*/)
+-{
+-    DeviceUpdateLEDs();
+-}
+-
+-void RGBController_GalaxGPUv1::DeviceUpdateMode()
+-{
+-    int new_mode = modes[active_mode].value;
+-
+-    controller->SetMode(new_mode);
+-}
