+-| usb_buf[1] = 0x80;                                |
+-| usb_buf[2] = 0x10;                                |
+-| usb_buf[3] = 0x01; or 0x02                        |
+-| usb_buf[4] = 0x02;                                |
+-| usb_buf[5] = 0x80;                                |
+-| hid_write(dev, usb_buf, CM_GD160_PACKET_LENGTH);  |
+-\*-------------------------------------------------*/
