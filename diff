+-RGBController_DasKeyboard::RGBController_DasKeyboard(DasKeyboardController* controller_ptr)
+-{
+-    controller  = controller_ptr;
+-
+-    for(unsigned int ii = 0; ii < zone_sizes[0]; ii++)
+-    {
+-        double_buffer.push_back(-1);
+-    }
