+-void PNYGPUController::WriteI2CData(u8 command, u8 length, u8* data)
+-{
+-    //Simulating i2c_smbus_write_i2c_block_data(command, length, data);
+-    for (u8 i = 0; i < length; i++)
+-    {
+-        bus->i2c_smbus_write_byte_data(dev, command+i, data[i]);
+-    }
+-}
