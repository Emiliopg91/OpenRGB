-    for(unsigned int led_idx = 0; led_idx < leds.size(); led_idx++)
-    {
-        /*-----------------------------------------------------*\
-        | Check intersection                                    |
-        \*-----------------------------------------------------*/
-        int posx = led_pos[led_idx].matrix_x * size + offset_x;
