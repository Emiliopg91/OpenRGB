+-void RGBController_QMKOpenRGBRevD::CountKeyTypes
+-    (
+-        std::vector<unsigned int>   led_flags,
+-        unsigned int                total_led_count,
+-        unsigned int&               key_leds,
+-        unsigned int&               underglow_leds
+-    )
+-{
+-    underglow_leds  = 0;
+-    key_leds        = 0;
+-
+-    for(unsigned int i = 0; i < total_led_count; i++)
+-    {
+-        if(led_flags[i] & 2)
