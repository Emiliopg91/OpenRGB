+-                          "B: " + controller->GetBluePath();
+-    }
+-    else
+-    {
+-        location        = controller->GetRgbPath();
+-    }
+-
+-    mode Direct;
+-    Direct.name         = "Direct";
+-    Direct.value        = 0;
+-    Direct.flags        = MODE_FLAG_HAS_PER_LED_COLOR;
+-    Direct.color_mode   = MODE_COLORS_PER_LED;
+-    modes.push_back(Direct);
+-
+-    SetupZones();
+-}
