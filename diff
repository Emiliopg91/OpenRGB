-        uint8_t pktsz = (uint8_t)std::min<size_t>(size, EVISION_V2_PACKET_SIZE - 8);
-        int result = Query(cmd, offset, nullptr, pktsz, odata);
-        if(result <= 0)
-        {
-            return result;
-        }
-        else if(result > size)
-        {
-            return -256;
-        }
-        offset += result;
-        odata += result;
-        size -= result;
-    }
-    return 0;
-}
