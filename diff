+-    write_buffer[1] = 0xFE;
+-    write_buffer[2] = 0x04;
+-    write_buffer[3] = RGBGetRValue(color);
+-    write_buffer[4] = RGBGetGValue(color);
+-    write_buffer[5] = RGBGetBValue(color);
+-
+-    hid_write(dev, write_buffer, sizeof(write_buffer));
+-}
