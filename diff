+-
+-        for(json::const_iterator it = data["panelLayout"]["layout"]["positionData"].begin(); it != data["panelLayout"]["layout"]["positionData"].end(); ++it)
+-        {
+-            panel_ids.push_back(it.value()["panelId"].get<int>());
+-        }
+-    }
